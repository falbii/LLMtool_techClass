<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.3" />
    <!-- Direct pins to override vulnerable transitive versions pulled in by the
         Copilot SDK (NU1902/NU1903). Remove once the SDK ships patched deps.
         MessagePack stays on 2.x: StreamJsonRpc targets that API line. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
    <PackageReference Include="Nerdbank.MessagePack" Version="1.2.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="itext7" Version="7.2.5" />
  </ItemGroup>

</Project>
